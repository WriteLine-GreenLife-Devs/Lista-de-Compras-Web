{
	"version": "2.0.0",
	"tasks": [
    {
      "label": "dotnet: build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "ListaDeCompras.WebApplication/ListaDeCompras.WebApplication.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "ListaDeCompras.WebApplication/ListaDeCompras.WebApplication.csproj"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "isBackground": false
    }
  ]
}
