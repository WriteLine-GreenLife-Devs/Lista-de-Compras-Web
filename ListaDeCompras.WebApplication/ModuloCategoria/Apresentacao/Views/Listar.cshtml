@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Categorias";
}

@model List<ListarCategoriasViewModel>;


<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhuma categoria cadastrada.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Cor</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarCategoriasViewModel c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Nome</td>
                        <td>@c.Cor</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@c.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
