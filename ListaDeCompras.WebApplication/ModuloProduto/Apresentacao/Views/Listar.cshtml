@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Produtos";
}

@model List<ListarProdutosViewModel>;


<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum produto cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Unidade de Medida</th>
                    <th>Preço</th>
                    <th>Categoria</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarProdutosViewModel p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nome</td>
                        <td>@p.UnidadeDeMedida</td>
                        <td>R$ @p.Preco.ToString("F2")</td>
                        <td>@p.CategoriaNome</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@p.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
