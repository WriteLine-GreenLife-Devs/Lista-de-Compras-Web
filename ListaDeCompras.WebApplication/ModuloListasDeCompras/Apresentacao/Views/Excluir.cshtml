@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Lista de Compras";
}

@model ExcluirListasDeComprasViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      method="post">
    <input asp-for="Id" type="hidden" />

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input value="@Model.Nome" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Itens Totais</label>
        <input value="@Model.ItensTotais" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Gasto Estimado</label>
        <input value="@Model.GastoEstimado.ToString("C")" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Status</label>
        <input value="@Model.Status" class="form-control" disabled>
    </div>

    <div class="alert alert-warning" role="alert">
        Tem certeza de que deseja excluir esta lista? Esta ação não poderá ser desfeita.
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Cancelar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
    </div>
</form>