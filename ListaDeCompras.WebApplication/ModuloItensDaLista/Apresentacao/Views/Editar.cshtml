@using ListaDeCompras.WebApplication.ModuloItensDaLista.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Item da Lista";
}

@model EditarItensDaListaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" method="post">
    <input asp-for="Id" type="hidden" />

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="ProdutoId" class="form-label fw-semibold text-primary text-uppercase small">Produto</label>
        <select asp-for="ProdutoId" class="form-select" asp-items="@(new SelectList(ViewBag.Produtos, "Id", "Nome"))"></select>
        <span asp-validation-for="ProdutoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ListaId" class="form-label fw-semibold text-primary text-uppercase small">Lista de Compras</label>
        <select asp-for="ListaId" class="form-select" asp-items="@(new SelectList(ViewBag.Listas, "Id", "Nome"))"></select>
        <span asp-validation-for="ListaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
        <input asp-for="Quantidade" type="number" class="form-control" min="1">
        <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PrecoUnitario" class="form-label fw-semibold text-primary text-uppercase small">Preço</label>
        <input asp-for="PrecoUnitario" type="number" step="0.01" class="form-control">
        <span asp-validation-for="PrecoUnitario" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>