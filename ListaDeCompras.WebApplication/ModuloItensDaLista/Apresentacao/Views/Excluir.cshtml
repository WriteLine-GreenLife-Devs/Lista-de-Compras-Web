@using ListaDeCompras.WebApplication.ModuloItensDaLista.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Item da Lista";
}

@model ExcluirItensDaListaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" method="post">
    <input asp-for="Id" type="hidden" />

    @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div asp-validation-summary="All" class="alert alert-danger border-danger rounded-3 p-3 mb-4" role="alert"></div>
    }

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Produto</label>
        <input value="@Model.ProdutoNome" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Lista</label>
        <input value="@Model.ListaNome" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Quantidade</label>
        <input value="@Model.Quantidade" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Preço Unitário</label>
        <input value="@Model.PrecoUnitario.ToString("C")" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Valor Total</label>
        <input value="@Model.ValorTotal.ToString("C")" class="form-control" disabled>
    </div>

    <div class="alert alert-warning" role="alert">
        Tem certeza de que deseja excluir este item? Esta ação não poderá ser desfeita.
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Cancelar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Excluir</button>
    </div>
</form>