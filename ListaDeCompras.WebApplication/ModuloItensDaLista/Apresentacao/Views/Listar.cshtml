@{
    Layout = "_Layout";
    ViewBag.Titulo = "Visualização de Itens da Lista de Compras";
}

@model List<ListarItensDaListaViewModel>;


<a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum item cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarItensDaListaViewModel idl in Model)
                {
                    <tr>
                        <td>@idl.Id</td>
                        <td>@idl.Nome</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@idl.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@idl.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}