@using ListaDeCompras.WebApplication.ModuloItensDaLista.Apresentacao
@using ListaDeCompras.WebApplication.ModuloListasDeCompras.Dominio
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Visualização de Itens da Lista";
}

@model List<ListarItensDaListaViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn-cadastrar-novo" asp-action="Cadastrar">Cadastrar Novo</a>

    <button class="btn-cadastrar-novo" type="button" data-bs-toggle="modal" data-bs-target="#filtroModal">
        Filtrar
    </button>
</div>

<div class="modal fade" id="filtroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-primary rounded-3">
            <div class="modal-header">
                <h5 class="modal-title text-primary">Filtrar por Lista</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="list-group">
                    <li class="list-group-item">
                        <a asp-action="Listar" asp-route-listaId="" class="text-decoration-none">Todas as listas</a>
                    </li>
                    @foreach (ListasDeCompras lista in ViewBag.Listas as List<ListasDeCompras>)
                    {
                        <li class="list-group-item">
                            <a asp-action="Listar" asp-route-listaId="@lista.Id" class="text-decoration-none">
                                @lista.Nome
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum item cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="registros">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produto</th>
                    <th>Lista</th>
                    <th>Quantidade</th>
                    <th>Preço</th>
                    <th>Valor Total</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ListarItensDaListaViewModel item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ProdutoNome</td>
                        <td>@item.ListaNome</td>
                        <td>@item.Quantidade</td>
                        <td>@item.PrecoUnitario.ToString("C")</td>
                        <td>@item.ValorTotal.ToString("C")</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@item.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@item.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}